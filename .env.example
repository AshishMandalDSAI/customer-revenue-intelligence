# Copy this file to .env and fill in real values. Never commit .env.

# --- Application ---
APP_ENV=development

# --- Database (PostgreSQL) ---
# Used by database/*.sql loaders and any future SQLAlchemy connections.
DATABASE_URL=postgresql://novamart:novamart@localhost:5432/novamart
POSTGRES_USER=novamart
POSTGRES_PASSWORD=novamart
POSTGRES_DB=novamart

# --- AI Analytics Copilot ---
# Optional. If left blank, ai_copilot/copilot.py automatically falls back
# to a deterministic, data-grounded assistant that queries local CSV/DB
# analytics instead of calling an LLM. No feature breaks without a key.
OPENAI_API_KEY=
COPILOT_MODEL=gpt-4o-mini

# --- Models ---
MODEL_PATH=models

# --- Reproducibility / dataset scale (all optional, see src/config.py) ---
RANDOM_SEED=42
